# Copy to .env and fill in.

# The DNS name of this server (an A/AAAA record pointing here).
LINKSY_DOMAIN=relay.linksy.diary.mg
# For Let's Encrypt's expiry notices.
LINKSY_EMAIL=you@example.com

# Optional tuning (defaults shown).
# How much one device may relay: 16 KiB/s, bursts of 256 KiB (a clipboard).
#LINKSY_TRICKLE_BYTES_PER_SECOND=16384
#LINKSY_TRICKLE_BURST_BYTES=262144
# New connections the server accepts per second, and in a burst.
#LINKSY_ACCEPT_PER_SECOND=50
#LINKSY_ACCEPT_BURST=200
